<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PAS</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;700&family=IBM+Plex+Sans:wght@400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
@{
    var role = Context.Session.GetString("PAS.UserRole");
    var name = Context.Session.GetString("PAS.UserName") ?? "Guest";
    var isAuthenticated = Context.Session.GetInt32("PAS.UserId").HasValue;
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();
    var isAuthPage = !isAuthenticated && controller == "Account" && action == "Login";
    string NavClass(string targetController) => controller == targetController ? "active" : string.Empty;
}

    <div class="app-shell @(isAuthPage ? "auth-shell" : string.Empty)">
        @if (isAuthenticated)
        {
            <aside class="app-sidebar">
                <div>
                    <p class="sidebar-kicker">PAS</p>
                    <h2>@role</h2>
                    <p class="sidebar-user">@name</p>
                </div>

                <nav class="sidebar-nav">
                    @if (role == "Student")
                    {
                        <a class="@NavClass("Student")" href="/Student/Dashboard">Overview</a>
                    }
                    else if (role == "Supervisor")
                    {
                        <a class="@NavClass("Supervisor")" href="/Supervisor/Dashboard">Blind Review Feed</a>
                    }
                    else if (role == "ModuleLeader" || role == "Administrator")
                    {
                        <a class="@NavClass("Admin")" href="/Admin/Dashboard">Management Overview</a>
                    }
                </nav>

                <form asp-controller="Account" asp-action="Logout" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn-light w-100">Logout</button>
                </form>
            </aside>
        }

        <main class="app-content @(isAuthPage ? "auth-content" : string.Empty)">
            @if (!isAuthPage)
            {
                <header class="top-bar">
                    <div>
                        <p class="top-kicker">Blind Matching Project Approval System</p>
                        <h1>@ViewData["Title"]</h1>
                    </div>
                </header>
            }

            @RenderBody()
        </main>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>